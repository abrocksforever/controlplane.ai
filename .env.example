# ControlPlane.ai Environment Configuration Template
# Copy this file to .env and configure your variables

# ----------------------------------------------------------------------------
# 1. Primary LLM API Keys (Optional - System uses deterministic fallback offline)
# ----------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ----------------------------------------------------------------------------
# 2. Risk Thresholds & Weight Overrides (Defaults shown below)
# ----------------------------------------------------------------------------
# CONTROLPLANE_ALLOW_THRESHOLD=2.5
# CONTROLPLANE_BLOCK_THRESHOLD=7.0
# CONTROLPLANE_WEIGHT_HEURISTIC=0.25
# CONTROLPLANE_WEIGHT_STATISTICAL=0.15
# CONTROLPLANE_WEIGHT_RAG_GROUNDING=0.35
# CONTROLPLANE_WEIGHT_AI_JUDGE=0.25

# ----------------------------------------------------------------------------
# 3. Web Dashboard Server Settings
# ----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
